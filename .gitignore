*.fastq.gz
*.tar
*.tar.gz
*.zip

# Resultados
# Se versionan SOLO las tablas y reportes de texto (evidencia reproducible).
# Los FASTA y datos pesados quedan excluidos por los patrones de arriba.
# Los patrones con ** alcanzan tambien las subcarpetas por fase
# (results/fase1/, results/fase2/, ...). La linea '!results/**/' es necesaria
# para que git entre en esos directorios; sin ella, un directorio ignorado no
# se recorre y las excepciones de abajo nunca se evaluan.
results/**
!results/**/
!results/**/*.md
!results/**/*.tsv
!results/**/*.txt
!results/**/*.csv
!results/**/*.tree
# Figuras generadas por las herramientas (dendrogramas de dRep, etc.).
# Son pequenas (decenas de KB) y son evidencia visual del analisis.
!results/**/*.pdf
!results/**/*.png

# Bases de datos
dbs/
*.dmnd

# Logs de SLURM
fase1_*.out
fase2_*.out
fase1_*.err
fase2_*.err
slurm-*.out

# Basura del SO / editores
.DS_Store
Thumbs.db
__pycache__/
*.pyc
